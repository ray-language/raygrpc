//! `raygrpc serve`: the demo services over h2c or TLS, with server reflection, on either
//! raygrpc's own HTTP/2 server (`-engine raygrpc`, the default) or net's
//! `net/grpc_server` (`-engine net`: unary only, no reflection, no response metadata).

import cli;
import demo;
import loader;
import reflection;
import schema;
import server;
import net/grpc_server;
import net/grpc_status;
import std/fs;
import std/net;
import std/time;

fn to_bytes_result(r: Result<server.Answer, grpc_status.Status>) -> Result<bytes, grpc_status.Status> {
    match (r) {
        Result.Ok(a) => Result.Ok(a.message),
        Result.Err(s) => Result.Err(s),
    }
}

/// A stop channel closed by SIGINT/SIGTERM or after `-for` seconds.
fn stop_channel(for_ms: int) -> Channel<int> {
    let stop: Channel<int> = Channel.new();
    spawn(fn() {
        let sigs = signals();
        while (true) {
            match (recv(sigs)) {
                Option.Some(s) => {
                    if (s == 2 || s == 15) {
                        close(stop);
                        break;
                    }
                },
                Option.None => break,
            }
        }
    });
    if (for_ms > 0) {
        spawn(fn() {
            time.sleep(for_ms);
            close(stop);
        });
    }
    stop
}

pub fn run(a: cli.Args) -> Result<int, string> {
    let host = cli.value_or(a, "host", "127.0.0.1");
    let port = cli.int_value(a, "port", 0)?;
    let engine = cli.value_or(a, "engine", "raygrpc");
    let cert_path = cli.value_or(a, "tls-cert", "");
    let key_path = cli.value_or(a, "tls-key", "");
    if ((cert_path == "") != (key_path == "")) {
        return Result.Err("-tls-cert and -tls-key go together");
    }
    let cert = if (cert_path != "") { fs.read_file(cert_path)? } else { "" };
    let key = if (key_path != "") { fs.read_file(key_path)? } else { "" };
    let reg = loader.demo_registry()?;
    let stop = stop_channel(cli.seconds_ms(a, "for")?);
    let kv = demo.start_kv();
    let mode = if (cert != "") { "TLS (no ALPN: see README)" } else { "h2c" };

    if (engine == "net") {
        if (cert != "") {
            return serve_net_tls(host, port, cert, key, reg, kv, stop, a, mode);
        }
        let l = grpc_server.bind(host, port)?;
        announce(a, host, l.port, mode, "net/grpc_server", false)?;
        grpc_server.serve_router_until(l, stop, grpc_server.default_options(), fn() -> grpc_server.Router {
            grpc_server.router().fallback(fn(c: grpc_server.Call) -> Result<bytes, grpc_status.Status> {
                to_bytes_result(demo.handle(c, kv, reg))
            })
        })?;
        return Result.Ok(0);
    }
    if (engine != "raygrpc") {
        return Result.Err("-engine must be raygrpc or net");
    }
    let listener = net.tcp_listen(host, port)?;
    let reflect = !cli.has(a, "no-reflection");
    let cfg = server.Config {
        tls_cert: cert,
        tls_key: key,
        reflection: reflect,
        index: reflection.index_of(reg),
        max_message: grpc_server.DEFAULT_MAX_MESSAGE,
        quiet: cli.has(a, "quiet"),
    };
    announce(a, host, net.local_port(listener), mode, "raygrpc", reflect)?;
    server.serve(listener, cfg, stop, fn(c: server.Call) -> Result<server.Answer, grpc_status.Status> {
        demo.handle(c, kv, reg)
    })?;
    Result.Ok(0)
}

fn announce(a: cli.Args, host: string, port: int, mode: string, engine: string, reflect: bool) -> Result<int, string> {
    let pf = cli.value_or(a, "port-file", "");
    if (pf != "") {
        fs.write_file(pf, "${port}\n")?;
    }
    let r = if (reflect) { ", reflection on" } else { "" };
    eprint("raygrpc serve: ${host}:${port} ${mode}, engine ${engine}${r}");
    Result.Ok(0)
}

/// net/grpc_server has no TLS listener: accept, wrap in TLS ourselves, hand it to serve_conn.
fn serve_net_tls(host: string, port: int, cert: string, key: string, reg: schema.Registry, kv: Channel<demo.KvMsg>, stop: Channel<int>, a: cli.Args, mode: string) -> Result<int, string> {
    let listener = net.tcp_listen(host, port)?;
    announce(a, host, net.local_port(listener), mode, "net/grpc_server", false)?;
    let conns: Channel<int> = Channel.bounded(64);
    spawn(fn() {
        while (true) {
            match (net.tcp_accept(listener)) {
                Result.Ok(h) => send(conns, h),
                Result.Err(_) => {
                    close(conns);
                    break;
                },
            }
        }
    });
    while (true) {
        match (select([conns, stop])) {
            0 => match (recv(conns)) {
                Option.Some(h) => {
                    spawn(fn() {
                        match (net.tls_accept(h, cert, key)) {
                            Result.Ok(t) => {
                                let r = grpc_server.router().fallback(fn(c: grpc_server.Call) -> Result<bytes, grpc_status.Status> {
                                    to_bytes_result(demo.handle(c, kv, reg))
                                });
                                grpc_server.serve_conn(t, grpc_server.default_options(), r);
                                close(t);
                            },
                            Result.Err(e) => {
                                eprint("raygrpc serve: TLS handshake: ${e}");
                                close(h);
                            },
                        }
                    });
                },
                Option.None => return Result.Ok(0),
            },
            _ => return Result.Ok(0),
        }
    }
}
