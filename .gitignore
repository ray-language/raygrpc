# dependencies downloaded by the package manager
.ray-deps/
# the web packages of dependencies, linked by ray for the editor
/node_modules/
# the device link of `ray dev --device` (port + token)
.ray-dev

# the native binary (make build)
/raygrpc
# scratch output of the scripts (throwaway certificates, logs, ports)
/out/
# never commit private keys
*.key.pem
